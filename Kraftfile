
spec: v0.6

name: app-wasmtime

rootfs: ./rootfs

unikraft:
  source: https://github.com/dblnz/unikraft.git
  version: update-ukrust-to-1.95
  kconfig:
    CONFIG_LIBDEVFS_AUTOMOUNT: 'y'
    CONFIG_LIBDEVFS: 'y'
    CONFIG_LIBUKFS_DEVFS: 'y'
    CONFIG_LIBPOSIX_PROCESS: 'y'
    CONFIG_LIBPOSIX_USER: 'y'
    CONFIG_LIBRAMFS: 'y'
    CONFIG_LIBUKCPIO: 'y'
    CONFIG_LIBUKMMAP: 'y'
    CONFIG_LIBUKSCHEDCOOP: 'y'
    CONFIG_LIBVFSCORE: 'y'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI: 'y'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI_INITRD: 'y'

targets:
- qemu/x86_64

libraries:
  rust:
    source: https://github.com/unikraft/lib-rust.git
    version: staging
    kconfig:
      - CONFIG_LIBUKCARGO=y
  wasmtime:
    source: https://github.com/dblnz/lib-wasmtime.git
    version: wip
    kconfig:
      - CONFIG_LIBUKWASMTIME=y
      - CONFIG_LIBUKWASMTIME_COMPONENT_MODEL=y
  musl:
    source: https://github.com/unikraft/lib-musl.git
    version: staging
